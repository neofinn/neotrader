# NeoTrader is PAPER-ONLY. Never commit real credentials.
# Generate a fresh Alpaca PAPER key pair in the Alpaca dashboard.
APCA_API_KEY_ID=replace_with_paper_key
APCA_API_SECRET_KEY=replace_with_paper_secret

# Backward-compatible aliases accepted by the client:
# ALPACA_API_KEY=replace_with_paper_key
# ALPACA_SECRET_KEY=replace_with_paper_secret

ALPACA_PAPER=true
NEO_TRADER_MODE=paper

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
NEOTRADER_OPERATOR_TOKEN=replace_with_long_random_token
